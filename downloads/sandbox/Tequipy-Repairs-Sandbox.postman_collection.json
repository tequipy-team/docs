                  "pm.test(\"State COMPLETED\", function () { pm.expect(pm.response.json().state).to.eql(\"COMPLETED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"COMPLETED\") { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Read equipment ready for return",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/user-equipment/{{deviceId1}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    var equipment = pm.response.json();",
                  "    pm.test(\"Equipment ACTIVE in storage\", function () { pm.expect(equipment.state).to.eql(\"ACTIVE\"); pm.expect(equipment.user.role).to.eql(\"STORAGE\"); pm.expect(equipment.storage.id).to.be.a(\"string\"); });",
                  "    if (equipment.state !== \"ACTIVE\" || equipment.user.role !== \"STORAGE\" || !equipment.storage || !equipment.storage.id) { pm.execution.setNextRequest(null); }",
                  "} else { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "14a Create return to the original employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/redeployments",
            "description": "Creates a return from storage. Expected state is RECEIVED, not delivered. Equipment is locked again while the redeployment is pending.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storageEquipmentIds\": [\n    \"{{deviceId1}}\"\n  ],\n  \"employeeId\": \"{{returnEmployeeId1}}\",\n  \"deliveryAddress\": {\n    \"fullName\": \"Sandbox {{runTag}}\",\n    \"phoneNumber\": \"+49301234567\",\n    \"streetLine1\": \"Friedrichstrasse 123\",\n    \"postalCode\": \"10117\",\n    \"city\": \"Berlin\",\n    \"countryCode\": \"DE\"\n  },\n  \"contactPersonEmail\": \"{{contactEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"returnEmployeeId1\")) { throw new Error(\"Run repair creation first to capture the original employee.\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "    var result = pm.response.json();",
                  "    pm.test(\"Return RECEIVED for original employee\", function () { pm.expect(result.state).to.eql(\"RECEIVED\"); pm.expect(result.user.id).to.eql(pm.collectionVariables.get(\"returnEmployeeId1\")); });",
                  "    if (result.state === \"RECEIVED\" && result.user.id === pm.collectionVariables.get(\"returnEmployeeId1\")) { pm.collectionVariables.set(\"redeploymentId1\", result.id); } else { pm.execution.setNextRequest(null); }",
                  "} else { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reject or cancel a repair",
      "item": [
        {
          "name": "15 Create a drop-off repair",
