              "mode": "raw",
              "raw": "{\n  \"action\": \"DELIVER\",\n  \"params\": {\n    \"deliveredAt\": \"{{deliveredAt}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State DELIVERED\", function () { pm.expect(pm.response.json().state).to.eql(\"DELIVERED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"DELIVERED\") { pm.execution.setNextRequest(null); }"
                ]
              }
