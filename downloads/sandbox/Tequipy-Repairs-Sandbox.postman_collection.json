              "mode": "raw",
              "raw": "{\n  \"storageEquipmentIds\": [\n    \"{{deviceId2}}\"\n  ],\n  \"employeeId\": \"{{returnEmployeeId2}}\",\n  \"deliveryAddress\": {\n    \"fullName\": \"Sandbox {{runTag}}\",\n    \"phoneNumber\": \"+48123456789\",\n    \"streetLine1\": \"Szewska 1\",\n    \"postalCode\": \"30-000\",\n    \"city\": \"Krakow\",\n    \"countryCode\": \"PL\"\n  },\n  \"contactPersonEmail\": \"{{contactEmail}}\"\n}",
