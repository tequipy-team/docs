                  "if (pm.response.code !== 200 || pm.response.json().state !== \"COMPLETED\") { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Read completed repair",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId1}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
