                  "    if (result.state === \"RECEIVED\" && result.user.id === pm.collectionVariables.get(\"returnEmployeeId2\")) { pm.collectionVariables.set(\"redeploymentId2\", result.id); } else { pm.execution.setNextRequest(null); }",
