        {
          "name": "10 Diagnose repair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId1}}/simulate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"DIAGNOSE\",\n  \"params\": {\n    \"diagnosis\": \"Broken display\",\n    \"price\": {\n      \"amount\": \"180.00\",\n      \"currency\": \"EUR\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State DIAGNOSED\", function () { pm.expect(pm.response.json().state).to.eql(\"DIAGNOSED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"DIAGNOSED\") { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
