              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId2}}/simulate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"PICK_UP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
