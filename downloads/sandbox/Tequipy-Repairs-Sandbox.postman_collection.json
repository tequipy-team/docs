        {
          "name": "11 Approve repair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId1}}/approve",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisionComment\": \"Approved in simulation {{runTag}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State REPAIR_APPROVED\", function () { pm.expect(pm.response.json().state).to.eql(\"REPAIR_APPROVED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"REPAIR_APPROVED\") { pm.execution.setNextRequest(null); }",
                  "pm.test(\"Final pricing\", function () { pm.expect(pm.response.json().pricingSummary.state).to.eql(\"FINAL\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Complete repair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId1}}/simulate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"COMPLETE\",\n  \"params\": {\n    \"completedAt\": \"{{completedAt}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
