{
  "info": {
    "name": "Tequipy Sandbox Repairs",
    "description": "Dev sandbox repair walkthrough. Requires the repair simulation release, an API_CLIENT token and three active test devices. Creates three repairs and two return redeployments, and sends notifications. Run once in order. Returns stop at RECEIVED; later return simulation is outside this collection. Existing pricing behavior is preserved.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "companyEntityId",
      "value": ""
    },
    {
      "key": "deviceId1",
      "value": ""
    },
    {
      "key": "deviceId2",
      "value": ""
    },
    {
      "key": "deviceId3",
      "value": ""
    },
    {
      "key": "contactEmail",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get(\"baseUrl\") !== \"https://dev.backend.tequipy.com/integration\") { throw new Error(\"Use the Tequipy dev sandbox URL.\"); }",
          "if (!pm.variables.get(\"token\")) { throw new Error(\"Set your sandbox token.\"); }",
          "if (pm.info.requestName === \"03 Create a scheduled repair\") {",
          "    [\"companyEntityId\", \"deviceId1\", \"deviceId2\", \"deviceId3\", \"contactEmail\"].forEach(function (key) {",
          "        if (!pm.variables.get(key)) { throw new Error(\"Set \" + key + \" before running the scenarios.\"); }",
          "    });",
          "    if (new Set([pm.variables.get(\"deviceId1\"), pm.variables.get(\"deviceId2\"), pm.variables.get(\"deviceId3\")]).size !== 3) { throw new Error(\"Select three different active devices.\"); }",
          "    [\"repairId1\", \"repairId2\", \"repairId3\", \"returnEmployeeId1\", \"returnEmployeeId2\", \"redeploymentId1\", \"redeploymentId2\"].forEach(function (key) { pm.collectionVariables.unset(key); });",
          "    pm.collectionVariables.set(\"runTag\", String(Date.now()));",
          "    function date(days) { return new Date(Date.now() + days * 86400000).toISOString().slice(0, 19); }",
          "    pm.collectionVariables.set(\"startAt\", date(30));",
          "    pm.collectionVariables.set(\"scheduledAt1\", date(1));",
          "    pm.collectionVariables.set(\"scheduledAt2\", date(2));",
          "    [\"pickedUpAt\", \"deliveredAt\", \"completedAt\"].forEach(function (key) { pm.collectionVariables.set(key, date(2)); });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Find your test data",
      "item": [
        {
          "name": "01 Read company entities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/company-entities"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Find active employee equipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/user-equipments/query?page=0&size=100",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceType\": \"EMPLOYEES\",\n  \"states\": [\n    \"ACTIVE\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Complete a repair after a failed pickup",
      "item": [
        {
          "name": "03 Create a scheduled repair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEquipmentId\": \"{{deviceId1}}\",\n  \"companyEntityId\": \"{{companyEntityId}}\",\n  \"requesterEmail\": \"{{contactEmail}}\",\n  \"reason\": \"Broken screen\",\n  \"notes\": \"repairs simulation {{runTag}}\",\n  \"pickUpDetails\": {\n    \"privateEmail\": \"{{contactEmail}}\",\n    \"fullName\": \"Sandbox {{runTag}}\",\n    \"phoneNumber\": \"+49301234567\",\n    \"streetLine1\": \"Friedrichstrasse 123\",\n    \"postalCode\": \"10117\",\n    \"city\": \"Berlin\",\n    \"countryCode\": \"DE\"\n  },\n  \"startAt\": \"{{startAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State SET\", function () { pm.expect(pm.response.json().state).to.eql(\"SET\"); });",
                  "if (pm.response.code === 200 && pm.response.json().state === \"SET\") { pm.collectionVariables.set(\"repairId1\", pm.response.json().id); } else { pm.execution.setNextRequest(null); }",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"SET\") { pm.execution.setNextRequest(null); }",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"returnEmployeeId1\", pm.response.json().user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Initiate repair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId1}}/simulate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"INITIATE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State INITIATED\", function () { pm.expect(pm.response.json().state).to.eql(\"INITIATED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"INITIATED\") { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Schedule pickup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/repairs/{{repairId1}}/simulate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"SCHEDULE_PICKUP\",\n  \"params\": {\n    \"scheduledAt\": \"{{scheduledAt1}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State SCHEDULED\", function () { pm.expect(pm.response.json().state).to.eql(\"SCHEDULED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"SCHEDULED\") { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Record failed pickup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
