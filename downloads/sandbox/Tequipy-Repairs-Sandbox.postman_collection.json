                  "pm.test(\"State PICK_UP_REJECTED\", function () { pm.expect(pm.response.json().state).to.eql(\"PICK_UP_REJECTED\"); });",
                  "if (pm.response.code !== 200 || pm.response.json().state !== \"PICK_UP_REJECTED\") { pm.execution.setNextRequest(null); }"
                ]
              }
            }
          ]
        },
