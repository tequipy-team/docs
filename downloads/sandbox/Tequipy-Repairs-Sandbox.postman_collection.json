              "raw": "{\n  \"userEquipmentId\": \"{{deviceId2}}\",\n  \"companyEntityId\": \"{{companyEntityId}}\",\n  \"requesterEmail\": \"{{contactEmail}}\",\n  \"reason\": \"Broken screen\",\n  \"notes\": \"repairs simulation {{runTag}}\",\n  \"pickUpDetails\": {\n    \"privateEmail\": \"{{contactEmail}}\",\n    \"fullName\": \"Sandbox {{runTag}}\",\n    \"phoneNumber\": \"+48123456789\",\n    \"streetLine1\": \"Szewska 1\",\n    \"postalCode\": \"30-000\",\n    \"city\": \"Krakow\",\n    \"countryCode\": \"PL\"\n  }\n}",
